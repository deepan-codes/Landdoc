# LandDoc Environment Variables
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_NAME=LandDoc
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration (when backend is ready)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_TIMEOUT=30000

# Database (when ready)
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Authentication (when implementing)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# File Storage (when implementing)
STORAGE_TYPE=local
STORAGE_PATH=./public/uploads

# Encryption (when implementing)
ENCRYPTION_KEY=

# Features (toggle features on/off)
NEXT_PUBLIC_ENABLE_OCR=false
NEXT_PUBLIC_ENABLE_BACKUP=false
NEXT_PUBLIC_ENABLE_SEARCH=false

# Logging
LOG_LEVEL=info
DEBUG=false
